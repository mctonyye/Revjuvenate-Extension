{
  "name": "revjuvenate-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chrome/Edge extension to run Revjuvenate automation recipes directly in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run icons && vite build",
